{
  "name": "flight-radar",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "server"
  ],
  "scripts": {
    "dev": "next dev",
    "dev:claude": "next dev -p 3100",
    "dev:all": "concurrently -n backend,frontend -c magenta,blue \"npm run server:dev\" \"npm run wait-for-server && npm run dev\"",
    "wait-for-server": "wait-on -t 60000 http://localhost:4000/health",
    "build": "next build",
    "start": "next start",
    "lint": "eslint --config config/eslint.config.mjs && node config/check-image-formats.mjs",
    "type-check": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --config config/vitest.config.ts",
    "test:watch": "vitest --config config/vitest.config.ts",
    "test:coverage": "vitest run --coverage --config config/vitest.config.ts",
    "storybook": "storybook dev -p 6006",
    "storybook:claude": "storybook dev -p 6106",
    "build-storybook": "storybook build",
    "server:dev": "npm run start:dev --workspace server",
    "server:build": "npm run build --workspace server"
  },
  "dependencies": {
    "lucide-react": "^1.48.0",
    "next": "16.2.11",
    "next-intl": "^4.14.7",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.3.1",
    "@storybook/addon-a11y": "^10.6.0",
    "@storybook/addon-docs": "^10.6.0",
    "@storybook/addon-mcp": "^10.6.0",
    "@storybook/nextjs-vite": "^10.6.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.1",
    "concurrently": "^10.0.5",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.2.11",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-storybook": "^10.6.0",
    "jsdom": "^30.1.1",
    "prettier": "^3.9.9",
    "schema-dts": "^2.0.0",
    "storybook": "^10.6.0",
    "tailwindcss": "^4",
    "typescript": "~6.0.3",
    "vite": "^8.3.1",
    "vitest": "^5.0.1",
    "wait-on": "^9.1.0"
  }
}
